<?xml version="1.0" encoding="utf-8" ?>
<Grid
    x:Class="Scan_Manga.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border
        Margin="0"
        Padding="20,0"
        Background="{AppThemeBinding Light={StaticResource White},
                                     Dark={StaticResource OffBlack}}"
        Stroke="Transparent"
        StrokeShape="Rectangle"
        StrokeThickness="0">
        <Border.Shadow>
            <Shadow
                Brush="{StaticResource Primary}"
                Opacity=".8"
                Radius="14"
                Offset="0,7" />
        </Border.Shadow>
        <HorizontalStackLayout>
            <Image
                Margin="10,6"
                HeightRequest="50"
                Source="scan_manga_icon.svg"
                WidthRequest="50" />
            <Label
                FontSize="Title"
                Style="{StaticResource Headline}"
                Text="Scan-Manga"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</Grid>
