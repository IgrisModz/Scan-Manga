<?xml version="1.0" encoding="utf-8" ?>
<Grid x:Class="Scan_Manga.Controls.ExpandableNavBar"
      xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:behaviors="clr-namespace:Scan_Manga.Behaviors"
      xmlns:controls="clr-namespace:Scan_Manga.Controls"
      xmlns:mi="http://www.igrismodz.com/dotnet/2026/maui/icons"
      InputTransparent="True"
      CascadeInputTransparent="False"
      x:DataType="controls:ExpandableNavBar">

    <!--  Overlay  -->
    <Grid x:Name="ClickOutsideOverlay"
          BackgroundColor="#40000000"
          IsVisible="False"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
            <PanGestureRecognizer PanUpdated="OnOverlayPan" />
            <PinchGestureRecognizer PinchUpdated="OnOverlayPinch" />
        </Grid.GestureRecognizers>
    </Grid>
    <!-- Floating menu host -->
    <Grid x:Name="MenuHost"
          HorizontalOptions="End"
          VerticalOptions="End"
          InputTransparent="False">
        <Grid.Margin>
            <OnPlatform x:TypeArguments="Thickness">
                <On Platform="iOS">
                    <Thickness>15</Thickness>
                </On>
                <On Platform="Android">
                    <Thickness>15</Thickness>
                </On>
                <On Platform="Default">
                    <Thickness>15,15,35,15</Thickness>
                </On>
            </OnPlatform>
        </Grid.Margin>
        <!-- Main navigation bar -->
        <Border x:Name="NavBar"
                WidthRequest="50"
                HeightRequest="50"
                HorizontalOptions="End"
                VerticalOptions="End"
                Padding="5,3,5,5"
                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                StrokeShape="RoundRectangle 25"
                StrokeThickness="0">
            
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Opacity="0.5" Radius="10" Offset="0,2" />
            </Border.Shadow>

            <Grid>
                <ScrollView x:Name="ExtraOptionsContainer"
                            Margin="10,0"
                            VerticalOptions="Start"
                            IsVisible="False"
                            Opacity="0">
                    <VerticalStackLayout x:Name="ExtraOptionsContent" Padding="0,5" Spacing="10">
                        <Label Text="INFORMATIONS"
                               FontSize="10"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Opacity="0.6" />

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                            <controls:IconButton x:Name="NoticesButton" Grid.Column="0" Icon="Gavel" Text="Légal" behaviors:CursorBehavior.Cursor="Hand" Clicked="OnNoticesClicked" />
                            <controls:IconButton x:Name="TermsButton" Grid.Column="1" Icon="Description" Text="CGU" behaviors:CursorBehavior.Cursor="Hand" Clicked="OnTermsClicked" />
                            <controls:IconButton x:Name="PrivacyButton" Grid.Column="2" Icon="Lock" Text="Privé" behaviors:CursorBehavior.Cursor="Hand" Clicked="OnPrivacyClicked" />
                            <controls:IconButton x:Name="AboutButton" Grid.Column="3" Icon="HelpCenter" Text="À Propos" behaviors:CursorBehavior.Cursor="Hand" Clicked="OnAboutClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- More -->
                <Grid x:Name="MoreBtnContainer"
                      HeightRequest="30"
                      Margin="0,0,0,72"
                      VerticalOptions="End"
                      IsVisible="False"
                      Opacity="0">

                    <Label x:Name="MoreIcon"
                           Text="{mi:MaterialSymbolsRounded Icon=KeyboardArrowUp}"
                           FontSize="30"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           behaviors:CursorBehavior.Cursor="Hand"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMoreTapped" />
                        </Label.GestureRecognizers>
                        
                    </Label>

                </Grid>
                
                <!-- Navigation buttons -->
                <Grid x:Name="NavBarContent" HeightRequest="72" VerticalOptions="End" ColumnDefinitions="*,*,*,*" IsVisible="False" Opacity="0">

                    <controls:IconButton x:Name="DonateButton"
                                         Grid.Column="0"
                                         Icon="Money"
                                         Text="Soutenir"
                                         behaviors:CursorBehavior.Cursor="Hand"
                                         Clicked="OnDonateClicked" />
                    
                    <controls:IconButton x:Name="RefreshButton"
                                         Grid.Column="1"
                                         Icon="Refresh"
                                         Text="Actualiser"
                                         RotateIconOnClick="True"
                                         behaviors:CursorBehavior.Cursor="Hand"
                                         Clicked="OnRefreshClicked" />
                    
                    <controls:IconButton x:Name="HomeButton"
                                         Grid.Column="2"
                                         Icon="Home"
                                         Text="Accueil"
                                         behaviors:CursorBehavior.Cursor="Hand"
                                         Clicked="OnHomeClicked" />
                    
                    <controls:IconButton x:Name="SettingsButton"
                                         Grid.Column="3"
                                         Icon="Settings"
                                         Text="Réglages"
                                         RotateIconOnClick="True"
                                         behaviors:CursorBehavior.Cursor="Hand"
                                         Clicked="OnSettingsClicked" />
                    
                </Grid>

                <Grid x:Name="ExpandBtnContainer"
                      WidthRequest="40"
                      HeightRequest="42"
                      IsVisible="True"
                      VerticalOptions="End"
                      HorizontalOptions="End">

                    <Label x:Name="ExpandBtn"
                           Text="{mi:MaterialSymbolsRounded Icon=Notes}"
                           behaviors:CursorBehavior.Cursor="Hand"
                           FontSize="27"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                </Grid>

            </Grid>
            
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="IgnoreOnOverlayTapped" />
            </Border.GestureRecognizers>

        </Border>

    </Grid>
    
</Grid>