<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Scan_Manga.Controls"
             xmlns:mi="http://www.igrismodz.com/dotnet/2026/maui/icons"
             x:Class="Scan_Manga.Controls.IconButton"
             x:Name="Root"
             x:DataType="controls:IconButton">
    
    <Grid x:Name="ButtonContainer"
          RowDefinitions="Auto,Auto"
          RowSpacing="{Binding Spacing}"
          BindingContext="{x:Reference Root}">
        
        <mi:MaterialSymbolsRoundedIcon x:Name="IconBtn"
                                       Grid.Row="0"
                                       FontSize="{Binding IconSize}"
                                       HorizontalOptions="Center"
                                       Icon="{Binding Icon}"
                                       TextColor="{Binding IconColor}"/>

        <Label Grid.Row="1"
               FontSize="{Binding FontSize}"
               FontAttributes="{Binding FontAttributes}"
               HorizontalTextAlignment="Center"
               LineBreakMode="TailTruncation"
               MaxLines="1"
               TextTransform="{Binding TextTransform}"
               TextColor="{Binding TextColor}"
               Text="{Binding Text}" />

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnButtonTapped" />
        </Grid.GestureRecognizers>
        
    </Grid>
</ContentView>
