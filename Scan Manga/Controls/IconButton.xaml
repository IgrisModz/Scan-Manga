<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Scan_Manga.Controls"
             xmlns:mi="http://www.igrismodz.com/dotnet/2026/maui/icons"
             x:Class="Scan_Manga.Controls.IconButton"
             x:DataType="controls:IconButton">
    <VerticalStackLayout>
        <mi:MaterialSymbolsRoundedIcon x:Name="IconBtn"
                                       FontSize="30"
                                       HorizontalOptions="Center"
                                       Icon="{Binding Icon}"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>

        <Label FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" TextTransform="Uppercase" Text="{Binding Text}" />

        <VerticalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnButtonTapped" />
        </VerticalStackLayout.GestureRecognizers>
    </VerticalStackLayout>
</ContentView>
