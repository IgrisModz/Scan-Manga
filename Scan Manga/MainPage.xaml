<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Scan_Manga.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    droid:NavigationBar.Color="{AppThemeBinding Dark=Black,
                                                Light=White}"
    droid:NavigationBar.Style="{AppThemeBinding Dark=LightContent,
                                                Light=DarkContent,
                                                Default=Default}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource Primary}" StatusBarStyle="Default" />
    </ContentPage.Behaviors>

    <RefreshView
        x:Name="WebRefreshView"
        IsRefreshing="False"
        Refreshing="OnRefresh">
        <Grid x:Name="MainRoot">
            <WebView
                x:Name="MainWebView"
                android:WebView.DisplayZoomControls="False"
                android:WebView.EnableZoomControls="True"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

        <!--  ProgressBar  -->
        <ProgressBar
            HeightRequest="4"
            HorizontalOptions="Fill"
            IsVisible="{Binding Source={x:Reference MainWebView}, Path=IsLoading}"
            Progress="{Binding Source={x:Reference MainWebView}, Path=Progress}"
            VerticalOptions="Start" />

        <!--  Offline overlay  -->
            <Grid
                x:Name="OfflineOverlay"
                BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                                  Dark={StaticResource OffBlack}}"
                IsVisible="False">
                <VerticalStackLayout
                    Margin="20"
                    HorizontalOptions="Center"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="⚠️ Impossible de charger la page.&#x0d;&#x0a;Vérifiez votre connexion Internet."
                        TextColor="Red"
                        VerticalOptions="Center" />
                    <Button Clicked="OnRefresh" Text="Réessayer" />
                </VerticalStackLayout>
            </Grid>

            <!--  Overlay transparent  -->
            <Grid
                x:Name="ClickOutsideOverlay"
                BackgroundColor="#40000000"
                IsVisible="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayTapped" />
                    <PanGestureRecognizer PanUpdated="OnOverlayPan" />
                    <PinchGestureRecognizer PinchUpdated="OnOverlayPinch" />
                </Grid.GestureRecognizers>
            </Grid>

            <Border
                x:Name="NavBar"
                Margin="10"
                Padding="5,3,5,5"
                Background="{AppThemeBinding Dark=#EE000000,
                                             Light=#E0FFFFFF}"
                HeightRequest="50"
                HorizontalOptions="End"
                StrokeShape="RoundRectangle 25"
                StrokeThickness="0"
                VerticalOptions="End"
                WidthRequest="50">
                <Border.Shadow>
                    <Shadow
                        Brush="{AppThemeBinding Dark={StaticResource White},
                                                Light={StaticResource Black}}"
                        Opacity=".8"
                        Radius="8"
                        Offset="0,2" />
                </Border.Shadow>
                <Grid x:Name="NavBarRoot" ColumnDefinitions="*,40">
                    <HorizontalStackLayout
                        x:Name="NavBarContent"
                        Padding="20,0"
                        IsVisible="False"
                        Spacing="20"
                        VerticalOptions="Center">

                        <VerticalStackLayout x:Name="InfoBtn">
                            <Label
                                FontSize="28"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{mi:Material Icon=Info}"
                                TextColor="{AppThemeBinding Dark=White,
                                                            Light=Black}"
                                VerticalOptions="Center"
                                WidthRequest="50" />
                            <Label FontSize="12" Text="Informations" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInfoClicked" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="RefreshBtn">
                            <Label
                                FontSize="28"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{mi:Material Icon=Refresh}"
                                TextColor="{AppThemeBinding Dark=White,
                                                            Light=Black}"
                                VerticalOptions="Center"
                                WidthRequest="50" />
                            <Label FontSize="12" Text="Rafraîchir" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRefresh" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Label
                        x:Name="ExpandBtn"
                        Grid.Column="1"
                        FontSize="Title"
                        HorizontalOptions="Center"
                        Text="{mi:Material Icon=Notes}"
                        TextColor="{AppThemeBinding Dark=White,
                                                    Light=Black}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExpandClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

            </Border>
        </Grid>
    </RefreshView>

</ContentPage>
