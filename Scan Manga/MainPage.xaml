<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Scan_Manga.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:controls="clr-namespace:Scan_Manga.Controls"
    xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    droid:NavigationBar.Color="{AppThemeBinding Dark={StaticResource OffBlack},
                                                Light={StaticResource White}}"
    droid:NavigationBar.Style="{AppThemeBinding Dark=LightContent,
                                                Light=DarkContent,
                                                Default=Default}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource Primary}" StatusBarStyle="Default" />
    </ContentPage.Behaviors>

    <Grid x:Name="MainRoot">
        <!--  Refresh uniquement sur le WebView  -->
        <RefreshView
            x:Name="WebRefreshView"
            IsRefreshing="False"
            Refreshing="OnRefresh">
            <controls:CustomWebView
                x:Name="MainWebView"
                android:WebView.DisplayZoomControls="False"
                android:WebView.EnableZoomControls="True"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />
        </RefreshView>

        <!--  Offline overlay  -->
        <Grid
            x:Name="OfflineOverlay"
            BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                              Dark={StaticResource OffBlack}}"
            IsVisible="False">
            <VerticalStackLayout
                Margin="20"
                HorizontalOptions="Center"
                Spacing="10"
                VerticalOptions="Center">
                <Label
                    x:Name="ErrorLabel"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="⚠️ Impossible de charger la page.&#x0d;&#x0a;Vérifiez votre connexion Internet."
                    TextColor="Red"
                    VerticalOptions="Center" />
                <Button Clicked="OnRefresh" Text="Réessayer" />
            </VerticalStackLayout>
        </Grid>

        <!--  ProgressBar  -->
        <ProgressBar
            x:DataType="controls:CustomWebView"
            HeightRequest="4"
            HorizontalOptions="Fill"
            IsVisible="{Binding IsLoading, Source={x:Reference MainWebView}}"
            Progress="{Binding Progress, Source={x:Reference MainWebView}}"
            VerticalOptions="Start" />

        <!--  Ta navbar n’est plus absorbée par RefreshView  -->
        <controls:ExpandableNavBar
            x:Name="NavBar"
            InfoTapped="OnInfoClicked"
            RefreshTapped="OnRefresh" />

    </Grid>

</ContentPage>
