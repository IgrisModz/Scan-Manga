<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Scan_Manga.Pages.InfoPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Scan_Manga.Pages"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:TypeArguments="local:ILegalPage"
    BackgroundColor="{AppThemeBinding Dark={StaticResource OffBlack},
                                      Light={StaticResource White}}">

    <toolkit:Popup.Resources>
        <toolkit:AppThemeColor
            x:Key="TextColor"
            Dark="White"
            Light="Black" />
    </toolkit:Popup.Resources>

    <VerticalStackLayout Spacing="6">

        <Label
            FontAttributes="Bold"
            FontSize="Title"
            HorizontalOptions="Center"
            Text="Informations"
            TextColor="{toolkit:AppThemeResource TextColor}" />

        <Button Clicked="OnNoticesClicked" Text="Mentions légales" />
        <Button Clicked="OnPrivacyClicked" Text="Confidentialité" />
        <Button Clicked="OnTermClicked" Text="Conditions d’utilisation" />
        <Button Clicked="OnAboutClicked" Text="À propos" />

    </VerticalStackLayout>
</toolkit:Popup>