<?xml version="1.0" encoding="utf-8" ?>
<controls:PageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Scan_Manga.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:viewmodels="clr-namespace:Scan_Manga.ViewModels"
    x:Class="Scan_Manga.Pages.SettingsPage"
    x:DataType="viewmodels:SettingsViewModel"
    Title="SettingsPage">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader />
        <ScrollView Grid.Row="1">
            <Grid>
                <Border Margin="20"
                        Shadow="{StaticResource BubbleShadow}"
                        VerticalOptions="Start">
                    <VerticalStackLayout Padding="25" Spacing="5">
                        <Label Text="Paramètres" FontSize="28" FontAttributes="Bold" Margin="0,0,0,10"/>

                        <VerticalStackLayout Spacing="15">
                            <Label Text="APPARENCE" FontSize="14" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <mi:MauiIcon Icon="{mi:Material Icon=Palette}" IconSize="26" IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Thème" VerticalOptions="Center" FontAttributes="Bold"/>
                                <controls:MaterialPicker Grid.Column="2"
                                                         VerticalOptions="Center"
                                                         Variant="Filled"
                                                         WidthRequest="150"
                                                         Options="{Binding ThemeOptions}"
                                                         SelectedOption="{Binding SelectedTheme}"/>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="15">
                            <Label Text="AFFICHAGE" FontSize="14" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <mi:MauiIcon Icon="{mi:Material Icon=Fullscreen}" IconSize="26" IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Mode plein écran" VerticalOptions="Center" FontAttributes="Bold" />
                                <controls:MaterialPicker Grid.Column="2"
                                                         VerticalOptions="Center"
                                                         Variant="Filled"
                                                         WidthRequest="150"
                                                         Options="{Binding FullScreenOptions}"
                                                         SelectedOption="{Binding SelectedFullScreenMode}"/>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="15">
                            <Label Text="CONFORT DE LECTURE" FontSize="14" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold"/>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <mi:MauiIcon Icon="{mi:Material Icon=Lightbulb}" IconSize="26" IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Garder l'écran allumé" VerticalOptions="Center" FontAttributes="Bold"/>
                                <controls:MaterialPicker Grid.Column="2"
                                                         VerticalOptions="Center"
                                                         Variant="Filled"
                                                         WidthRequest="150"
                                                         Options="{Binding KeepScreenOnOptions}"
                                                         SelectedOption="{Binding SelectedKeepScreenOnMode}"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEE, Dark=#333}"/>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <mi:MauiIcon Icon="{mi:Material Icon=DoNotDisturb}" IconSize="26" IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Bloqueur de publicités" VerticalOptions="Center" FontAttributes="Bold"/>
                                <Switch IsToggled="{Binding IsAdBlockerEnabled}" Grid.Column="2"/>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="15">
                            <Label Text="NAVIGATION ET DONNÉES" FontSize="14" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold"/>

                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
                                <mi:MauiIcon Icon="{mi:Material Icon=PlayCircle}" IconSize="26" IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" VerticalOptions="Center"/>

                                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Label Grid.Column="1" Text="Reprendre la lecture" VerticalOptions="Center" FontAttributes="Bold"/>

                                    <mi:MauiIcon Grid.Column="2" 
                                                     Icon="{mi:Material Icon=Info}"
                                                     IconSize="18"
                                                     IconColor="Gray"
                                                     VerticalOptions="Center">
                                        <mi:MauiIcon.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowRestoreHelpCommand}"/>
                                        </mi:MauiIcon.GestureRecognizers>
                                    </mi:MauiIcon>
                                </HorizontalStackLayout>

                                <Switch Grid.Column="3" IsToggled="{Binding LoadLastPageOnStartup}"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <mi:MauiIcon Icon="{mi:Material Icon=History}" IconSize="26" IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Enregistrer l'historique" VerticalOptions="Center" FontAttributes="Bold"/>
                                <Switch IsToggled="{Binding IsHistoryEnabled}" Grid.Column="2"/>
                            </Grid>
                        </VerticalStackLayout>
                        
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEE, Dark=#333}" Margin="0,10"/>

                        <Grid ColumnDefinitions="*, *" Padding="0,5">
                            <VerticalStackLayout x:Name="ClearHistoryLayout" Spacing="4" HorizontalOptions="Center">
                                <Label FontSize="28"
                                       HorizontalOptions="Center"
                                       FontFamily="MaterialIcons"
                                       Text="{mi:Material Icon=DeleteForever}"
                                       TextColor="#FF453A" />
                                <Label FontSize="11" 
                                       Text="Vider l'historique" 
                                       TextColor="#FF453A"
                                       HorizontalOptions="Center"/>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearHistoryCommand}" CommandParameter="{x:Reference ClearHistoryLayout}" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="GoBackLayout" Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                                <Label FontSize="28"
                                       HorizontalOptions="Center"
                                       FontFamily="MaterialIcons"
                                       Text="{mi:Material Icon=ArrowBack}"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label FontSize="11" 
                                       Text="Retour" 
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       HorizontalOptions="Center"/>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoBackCommand}" CommandParameter="{x:Reference GoBackLayout}" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
            </Border>
            </Grid>
        </ScrollView>

        <controls:CustomOverlay Grid.RowSpan="2"
                                Title="{Binding OverlayTitle}"
                                Message="{Binding OverlayMessage}"
                                ConfirmText="{Binding OverlayConfirmText}"
                                CancelText="{Binding OverlayCancelText}"
                                IsOpen="{Binding IsOverlayVisible, Mode=TwoWay}"
                                ResponseCommand="{Binding OverlayResultCommand}"/>
    </Grid>
</controls:PageBase>